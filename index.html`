        </div>
    </nav>

    <!-- Header/Hero -->
    <header class="bg-white py-20 px-6 text-center border-b border-slate-200">
        <div class="max-w-4xl mx-auto">
            <span class="text-blue-600 font-bold tracking-[0.2em] uppercase text-xs">FOUNDLY</span>
            <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 mt-4 mb-6 leading-tight">
                Convierte tu negocio en un <span class="text-blue-600">imán de clientes</span>
            </h1>
            <p class="text-lg text-slate-600 mb-10 max-w-2xl mx-auto">
                Ayudo a negocios locales a dejar de depender solo de Instagram y empezar a atraer clientes automáticamente desde Google con páginas web profesionales y optimizadas.
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4 mb-8">
                <a href="#demos" class="bg-blue-600 text-white px-8 py-4 rounded-full font-bold text-lg shadow-lg shadow-blue-200 hover:bg-blue-700 transition-all transform hover:-translate-y-1">
                    Ver Demos en Vivo
                </a>
                <a href="https://wa.me/TU_NUMERO" class="bg-white text-slate-700 border border-slate-200 px-8 py-4 rounded-full font-bold text-lg hover:bg-slate-50 transition-all">
